# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1
FRONTEND_URL=https://app.leo.com

# ── Database ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leo_db
DB_USER=leo_user
DB_PASS=strong_password_here
DB_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_64_char_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256-GCM) ──────────────────────────────────────────
# 32-byte hex string (64 hex chars)
AES_KEY=change_this_to_64_hex_chars_for_32_byte_key_00000000000000000000

# ── OTP ───────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5

# ── AWS S3 ────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=leo-platform-assets

# ── Firebase (FCM) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=leo-platform
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@leo-platform.iam.gserviceaccount.com

# ── Elasticsearch ─────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# ── Payment Gateways ──────────────────────────────────────────────────
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_private_key
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# ── WhatsApp Business API ─────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# ── Throttle ──────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Premium Boost ─────────────────────────────────────────────────────
PREMIUM_BOOST_HOURS=4
PREMIUM_MONTHLY_BDT=100

# ── Permanent Job Fees ────────────────────────────────────────────────
PERMANENT_JOB_FEE_BDT=250

# ── Short Contract Commission ─────────────────────────────────────────
SHORT_CONTRACT_COMMISSION_PERCENT=2

# ── Withdrawal ────────────────────────────────────────────────────────
WITHDRAWAL_SLA_HOURS=24
WITHDRAWAL_MINIMUM_BDT=100
